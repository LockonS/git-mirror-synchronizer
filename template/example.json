[
  {
    "upstream": {
      "name": "origin",
      "repoUrl": "https://github.com/LockonS/git-mirror-synchronizer.git"
    },
    "repo": {
      "storagePath": "/opt/git/git-repo",
      "pathPrefix": "tool",
      "identifier": "LockonS/git-mirror-synchronizer"
    },
    "release": {
      "storagePath": "/opt/git/git-release",
      "pathPrefix": "tool",
      "identifier": "LockonS/git-mirror-synchronizer",
      "download": "true",
      "keptVersionNum": "3"
    },
    "tag": {
      "download": "true",
      "keptVersionNum": "3"
    },
    "mirror": [
      {
        "name": "gitlab",
        "repoUrl": "git@gitlab.dreamisty.com:mirror/LockonS/git-mirror-synchronizer.git",
        "forcePush": "false"
      }
    ]
  }
]